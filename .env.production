# Leave VITE_API_URL unset (or set to /api) for same-origin deployment
# where Apache/LiteSpeed serves the built frontend AND proxies /api to
# the Node backend on the same domain. Only override this if the API is
# hosted on a different domain, e.g.:
# VITE_API_URL=https://api.bazaztech.com/api
VITE_API_URL=/api
